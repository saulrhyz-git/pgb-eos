+// against.
+function endDateForQuarter(year: RockCandidate["year"], quarter: number): Date {
+  const custom =
+    quarter === 1 ? year.q1EndDate : quarter === 2 ? year.q2EndDate : quarter === 3 ? year.q3EndDate : quarter === 4 ? year.q4EndDate : null;
