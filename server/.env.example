DATABASE_URL="postgresql://eos_user:eos_password@localhost:5432/eos_dashboard?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
# Admin → Backup & Restore: allow restoring a backup INTO this instance
# (replaces all data). Only on the instance you restore into — never on production.
ALLOW_DATA_RESTORE=false
