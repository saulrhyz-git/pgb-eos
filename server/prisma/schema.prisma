// EOS Executive Dashboard - Prisma schema
// Hierarchy: Year -> Business Unit -> Member Company -> Quarter
// Every financial figure is split Internal / External.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  GROUP_INTEGRATOR
  BU_INTEGRATOR
}

// The gate-able areas of the app a Custom Role's permission matrix can grant
// View/Edit/Delete over, independently, per Business Unit or Company.
// TARGETS covers the Target Setup page (QuarterTarget records); REVENUE/
// COLLECTIONS/EXPENSES cover their matching figures wherever they appear
// (Revenue dashboard KPIs/chart/matrix, Operational Grid, Data Entry/actuals,
// per-category Remarks); ROCKS covers the Rocks page. SCORECARD and
// AUDIT_LOG each gate their own page itself (a coarse "can this user open
// the page at all" check) — only canView is meaningful for either (nothing
// to edit or delete on a read-only summary/log page), canEdit/canDelete are
// simply ignored for them. The Audit Log itself isn't scoped by Business
// Unit/Company the way the others are (it's a global security log), so a
// Custom Role's AUDIT_LOG grant is checked without regard to which
// Business Unit/Company row it's attached to — see routes/auditLog.ts.
// DISBURSEMENTS is one combined resource covering all three Disbursement
// sub-categories (Advances/Loans/Interests) together — unlike REVENUE/
// COLLECTIONS/EXPENSES, which are each independently gate-able, a single
// DISBURSEMENTS grant covers all three at once (same granularity as ROCKS).
// COMPARISON gates the side-by-side Comparison tab — another coarse
// "can this user open the page at all" resource like SCORECARD/REPORTS
// (only canView is meaningful; the page itself is read-only). It has its
// own Business Unit/Company filters (one pair per panel), so — like
// SCORECARD/REPORTS/DISBURSEMENTS — it's included in ALL_RESOURCES.
enum PermissionResource {
  TARGETS
  REVENUE
  COLLECTIONS
  EXPENSES
  ROCKS
  SCORECARD
  AUDIT_LOG
  REPORTS
  DISBURSEMENTS
  COMPARISON
  AI_ANALYSIS
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  username           String?  @unique
  passwordHash       String
  name               String
  // Optional — a user can be created with no base Role at all ("blank"),
  // relying entirely on their assigned CustomRole(s) for access (see
  // customRoles below). A blank-role user with no CustomRole assigned has no
  // access to anything (see hasGlobalBusinessUnitAccess in middleware/auth.ts).
  role               Role?
  // Superadmin-authored free-text note about this user (e.g. their title or
  // team) — shown in the app header in place of their role. Not editable by
  // the user themselves; see PUT /api/admin/users/:id.
  description        String   @default("")
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())

  // Login lockout: 3 consecutive invalid-password attempts locks the
  // account for 60 seconds. failedLoginAttempts counts consecutive
  // failures since the last success (or since the last lock expired);
  // lockedUntil is set the moment the 3rd failure happens and cleared
  // again once a login succeeds or the lock naturally expires. See
  // POST /api/auth/login in routes/auth.ts for the enforcement.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Optional, additional layer on top of `role`. When any are assigned
  // (typically for a GROUP_INTEGRATOR or BU_INTEGRATOR), the user's effective
  // View/Edit/Delete access to Targets/Revenue/Collections/Expenses/Rocks per
  // Business Unit or Company is governed by the UNION of every assigned
  // Custom Role's permission matrix, layered ADDITIVELY on top of (never in
  // place of) the coarser "everything in my assigned Business Unit(s)"
  // default — a Custom Role only narrows a resource it actually addresses;
  // one that never mentions a given resource leaves the base role's normal
  // access to it untouched (see hasAnyGrant() in utils/permissions.ts).
  // Superadmins ignore this entirely (always full access). A user may have
  // any number of Custom Roles (see UserCustomRole below), not just one.
  customRoles UserCustomRole[]

  businessUnits       UserBusinessUnit[]
  actualEdits         QuarterActual[]      @relation("ActualEditedBy")
  disbursementEdits   DisbursementActual[] @relation("DisbursementEditedBy")
  rockCreations       Rock[]               @relation("RockCreatedBy")
  rockEdits           Rock[]               @relation("RockUpdatedBy")
  targetLocks         TargetLock[]

  @@index([role])
}

// Join table for the User <-> CustomRole many-to-many: a Superadmin can
// assign any number of Custom Roles to the same user (e.g. one narrowing
// Collections visibility, another separately granting Rocks view), and their
// effective permissions are the union of every assigned role's matrix. See
// loadUserPermissions() in middleware/auth.ts for how these are merged.
model UserCustomRole {
  userId       String
  customRoleId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)

  @@id([userId, customRoleId])
  @@index([customRoleId])
}

// A named, superadmin-authored permission profile: a matrix of which
// Business Units and/or Companies are accessible, broken down by resource
// (Targets/Revenue/Collections/Expenses/Rocks) and action (View/Edit/
// Delete). Assignable to any number of Users to give them exactly the
// accountability slice they need instead of a blanket BU assignment.
model CustomRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserCustomRole[]
}

// One row = "for this Business Unit (or, if companyId is set, this specific
// Company) and this resource, here's what's allowed." A Company-level row
// takes precedence over a Business-Unit-level row for the same resource
// when both exist, letting a role grant BU-wide access with a narrower (or
// wider) carve-out for one specific Company.
model RolePermission {
  id             String             @id @default(uuid())
  customRoleId   String
  businessUnitId String?
  companyId      String?
  resource       PermissionResource
  canView        Boolean            @default(false)
  canEdit        Boolean            @default(false)
  canDelete      Boolean            @default(false)

  customRole   CustomRole    @relation(fields: [customRoleId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([customRoleId])
  @@index([businessUnitId])
  @@index([companyId])
}

// Append-only security/activity log. Deliberately has no foreign-key
// relation to User: a log entry survives (with a readable snapshot of who
// acted, via userName/userEmail) even after that User is later deleted, and
// deleting a User is never blocked or complicated by their own audit
// history. `action`/`entityType` are free-text (not enums) so new action
// kinds can be added anywhere in the codebase without a schema migration —
// see utils/auditLog.ts for the writer and the fixed set of action strings
// currently in use.
model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId    String?
  userName  String  @default("")
  userEmail String  @default("")

  action     String // e.g. "USER_CREATE", "TARGET_QUARTER_UPDATE", "ROCK_DELETE", "LOGIN"
  entityType String // e.g. "User", "QuarterTarget", "Rock", "BusinessUnit"
  entityId   String?
  summary    String // human-readable one-line description
  metadata   Json?  // optional structured details (e.g. changed fields, old/new values)

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
}

// Singleton row (fixed id "default") holding the outbound SMTP configuration
// used to send email notifications. Managed by SUPERADMIN only.
model SmtpSettings {
  id          String   @id
  host        String
  port        Int      @default(587)
  secure      Boolean  @default(false)
  username    String?
  password    String?
  fromAddress String
  fromName    String?
  updatedAt   DateTime @updatedAt
}

// Singleton row (fixed id "default") holding the Google Gemini configuration
// used by the AI Analysis feature — an API key and a free-text model name
// rather than a hardcoded/enum model, since Gemini model names/availability
// change over time (a pinned dated model like "gemini-2.5-flash" can be, and
// was, retired for new callers) and this way an admin can pick up a new one
// without a code change. Defaults to "gemini-flash-latest", a Google-
// maintained alias that always resolves to the current recommended Flash
// model rather than a specific dated release, so the default itself doesn't
// go stale the way a pinned model name eventually will. Managed by
// SUPERADMIN only, same as SmtpSettings above; the API key itself is never
// echoed back to the frontend (see server/src/routes/settings.ts's
// serialize()), only whether one is currently set.
model AiSettings {
  id        String   @id
  apiKey    String?
  model     String   @default("gemini-flash-latest")
  updatedAt DateTime @updatedAt
}

// Join table: which BU(s) a BU Integrator is responsible for.
model UserBusinessUnit {
  userId        String
  businessUnitId String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@id([userId, businessUnitId])
  @@index([businessUnitId])
}

model BusinessUnit {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  companies      Company[]
  users          UserBusinessUnit[]
  businessGoals  BusinessGoalBusinessUnit[]
  rolePermissions RolePermission[]
}

model Company {
  id             String   @id @default(uuid())
  name           String
  description    String   @default("")
  businessUnitId String
  createdAt      DateTime @default(now())

  businessUnit        BusinessUnit         @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  quarterTargets      QuarterTarget[]
  quarterActuals      QuarterActual[]
  disbursementActuals DisbursementActual[]
  expenseNotes        ExpenseNote[]
  disbursementNotes   DisbursementNote[]
  rocks               Rock[]
  rolePermissions     RolePermission[]

  @@unique([businessUnitId, name])
  @@index([businessUnitId])
}

model Year {
  id        String   @id @default(uuid())
  year      Int      @unique
  createdAt DateTime @default(now())

  quarterTargets      QuarterTarget[]
  quarterActuals      QuarterActual[]
  disbursementActuals DisbursementActual[]
  expenseNotes        ExpenseNote[]
  disbursementNotes   DisbursementNote[]
  rocks               Rock[]
  targetLocks         TargetLock[]
}

// A manual, admin-controlled lock on a Year+Quarter's Targets. This is the
// *only* mechanism that locks a Quarter's Targets — routes/targets.ts has
// no automatic calendar-based lock, so a Quarter stays editable
// indefinitely, past or future, unless a Group Integrator/Superadmin has
// explicitly locked it here. Applies to every Company at once for that
// Year+Quarter (no per-Business-Unit/Company scoping). Only a Group
// Integrator or Superadmin can lock or unlock (see requireRole in
// routes/targets.ts) — this is a governance action, not something a Custom
// Role can grant. Existence of a row means locked; there's no separate
// "unlocked" state to store. Locking is a plain create; unlocking deletes
// the row, but requires a reason from the caller — that reason isn't
// persisted here (this table only ever reflects *current* state), it's
// written to the Audit Log instead (TARGET_UNLOCK), so there's a permanent
// record of who unlocked what and why even though the lock itself can be
// freely re-applied afterward. Unlocking a Quarter here makes it
// immediately editable again, since there's no other lock underneath it.
model TargetLock {
  id         String   @id @default(uuid())
  yearId     String
  quarter    Int // 1-4
  lockedById String?
  createdAt  DateTime @default(now())

  year     Year  @relation(fields: [yearId], references: [id], onDelete: Cascade)
  lockedBy User? @relation(fields: [lockedById], references: [id], onDelete: SetNull)

  @@unique([yearId, quarter])
}

// Quarter target: set once per Company per Year+Quarter (Group Integrator,
// Superadmin, or a BU Integrator scoped to their own BU). There is no
// separately-stored Annual Target anymore — "Annual Target" is purely a
// derived figure, computed on the fly in routes/dashboard.ts by summing a
// Company's (or Business Unit's) QuarterTarget rows across Q1-Q4, the same
// way BU-level actuals are a rollup of each Company's QuarterActual.
// Revenue stays a plain Internal/External pair. Collections is Internal and
// External, each broken into three recognition types (Earned/Unearned/
// Others). Expenses is a single plain amount — it used to be a fixed 3-way
// breakdown (Interest/Depreciation/Other Non-Cash), but that was collapsed
// to one number since Target-setting doesn't need that level of detail; a
// Business Unit can still log significant Interest/Depreciation/Other-
// Non-Cash/Cost-of-Sales/OPEX items at Actuals time via ExpenseNote below,
// purely for record-keeping (never rolled into this figure).
model QuarterTarget {
  id        String @id @default(uuid())
  companyId String
  yearId    String
  quarter   Int // 1-4

  revenueInternal Decimal @default(0) @db.Decimal(14, 2)
  revenueExternal Decimal @default(0) @db.Decimal(14, 2)

  collectionsInternalEarned   Decimal @default(0) @db.Decimal(14, 2)
  collectionsInternalUnearned Decimal @default(0) @db.Decimal(14, 2)
  collectionsInternalOthers   Decimal @default(0) @db.Decimal(14, 2)
  collectionsExternalEarned   Decimal @default(0) @db.Decimal(14, 2)
  collectionsExternalUnearned Decimal @default(0) @db.Decimal(14, 2)
  collectionsExternalOthers   Decimal @default(0) @db.Decimal(14, 2)

  expenses Decimal @default(0) @db.Decimal(14, 2)

  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year    Year    @relation(fields: [yearId], references: [id], onDelete: Cascade)

  @@unique([companyId, yearId, quarter])
  @@index([yearId, quarter])
}

// Quarter actual: entered by the BU Integrator (or overridden by Group Integrator).
// Same figure shape as QuarterTarget above, plus one Remarks field per
// category (Collections still gets six, one per breakdown; Expenses is now
// a single plain amount with a single Remarks field, same granularity as
// Revenue — see the QuarterTarget comment above for why the old 3-way
// Expenses breakdown was collapsed).
model QuarterActual {
  id        String @id @default(uuid())
  companyId String
  yearId    String
  quarter   Int // 1-4

  revenueInternal Decimal @default(0) @db.Decimal(14, 2)
  revenueExternal Decimal @default(0) @db.Decimal(14, 2)

  collectionsInternalEarned   Decimal @default(0) @db.Decimal(14, 2)
  collectionsInternalUnearned Decimal @default(0) @db.Decimal(14, 2)
  collectionsInternalOthers   Decimal @default(0) @db.Decimal(14, 2)
  collectionsExternalEarned   Decimal @default(0) @db.Decimal(14, 2)
  collectionsExternalUnearned Decimal @default(0) @db.Decimal(14, 2)
  collectionsExternalOthers   Decimal @default(0) @db.Decimal(14, 2)

  expenses Decimal @default(0) @db.Decimal(14, 2)

  revenueRemarks String @default("")

  collectionsInternalEarnedRemarks   String @default("")
  collectionsInternalUnearnedRemarks String @default("")
  collectionsInternalOthersRemarks   String @default("")
  collectionsExternalEarnedRemarks   String @default("")
  collectionsExternalUnearnedRemarks String @default("")
  collectionsExternalOthersRemarks   String @default("")

  expensesRemarks String @default("")

  updatedById String?
  updatedAt   DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year      Year    @relation(fields: [yearId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation("ActualEditedBy", fields: [updatedById], references: [id])

  @@unique([companyId, yearId, quarter])
  @@index([yearId, quarter])
  @@index([companyId])
}

// Disbursements: recorded — not targeted — per Company/Year/Quarter, same
// hierarchy as Quarter Actuals but with no corresponding Target model. Feeds
// the KPI cards on the Revenue dashboard and Executive Scorecard today, and
// is intended as a building block toward a later consolidated financial
// pane of glass. Used to be three sub-categories (Advances/Loans/Interests)
// each split Internal/External with their own Remarks — collapsed to a
// single plain amount + one Remarks field, same simplification as Expenses
// above; a Business Unit can still log significant disbursement items via
// DisbursementNote below, purely for record-keeping (never rolled into this
// figure). Still gated by the single combined DISBURSEMENTS Custom Role
// resource — see routes/disbursements.ts.
model DisbursementActual {
  id        String @id @default(uuid())
  companyId String
  yearId    String
  quarter   Int // 1-4

  amount  Decimal @default(0) @db.Decimal(14, 2)
  remarks String  @default("")

  updatedById String?
  updatedAt   DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year      Year    @relation(fields: [yearId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation("DisbursementEditedBy", fields: [updatedById], references: [id])

  @@unique([companyId, yearId, quarter])
  @@index([yearId, quarter])
  @@index([companyId])
}

// The type of thing a NoteCategory applies to — kept as its own enum
// (rather than reusing PermissionResource) since this is purely a display/
// grouping concern, unrelated to access control.
enum NoteCategoryType {
  EXPENSE
  DISBURSEMENT
}

// Superadmin-managed catalog of selectable categories for the "notable line
// items" record-keeping facility on Expenses and Disbursements (see
// ExpenseNote/DisbursementNote below) — e.g. "Interest", "Depreciation",
// "Other Non-Cash", "Cost of Sales", "OPEX" for Expenses; "Advances",
// "Loans", "Interest" for Disbursements, seeded as defaults by migration but
// freely editable afterward at Admin -> Note Categories. Purely a label
// picklist with no bearing on any total/calculation. `active` lets a
// category be retired without breaking historical notes that still
// reference it (existing notes keep their categoryId; the picker in
// new-entry UI just hides inactive ones going forward).
model NoteCategory {
  id        String           @id @default(uuid())
  type      NoteCategoryType
  label     String
  sortOrder Int              @default(0)
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())

  expenseNotes      ExpenseNote[]
  disbursementNotes DisbursementNote[]

  @@unique([type, label])
  @@index([type])
}

// One "notable expense item" logged for a Company/Year/Quarter — e.g.
// "Interest, PHP 120,000, remarks: refinanced Q2 loan". Purely informational
// record-keeping: never summed into the Expenses actual, KPI cards,
// attainment %, or AI Analysis figures (see aggregate.ts/computeScorecard,
// neither of which reads this table). Growable — a Company/Quarter can have
// any number of these, freely added/removed, replacing the old fixed
// 3-field expensesInterest/Depreciation/OtherNonCash breakdown. Gated by the
// same EXPENSES Custom Role resource as the Expenses actual itself (no
// separate resource) — see routes/notes.ts.
model ExpenseNote {
  id         String   @id @default(uuid())
  companyId  String
  yearId     String
  quarter    Int // 1-4
  categoryId String
  amount     Decimal  @default(0) @db.Decimal(14, 2)
  remarks    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year     Year         @relation(fields: [yearId], references: [id], onDelete: Cascade)
  category NoteCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([companyId, yearId, quarter])
  @@index([categoryId])
}

// Same idea as ExpenseNote, for Disbursements — gated by the DISBURSEMENTS
// Custom Role resource instead.
model DisbursementNote {
  id         String   @id @default(uuid())
  companyId  String
  yearId     String
  quarter    Int // 1-4
  categoryId String
  amount     Decimal  @default(0) @db.Decimal(14, 2)
  remarks    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year     Year         @relation(fields: [yearId], references: [id], onDelete: Cascade)
  category NoteCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([companyId, yearId, quarter])
  @@index([categoryId])
}

enum RockStatus {
  PENDING
  ON_TRACK
  AT_RISK
  TARGET_MET
}

// A strategic objective / theme that Rocks can be tied to. Managed by
// Group Integrators and Superadmins. A Business Goal with no Business Unit
// assignment is global (visible/usable everywhere); assigning it to one or
// more specific Business Units narrows it to just those units, the same
// "opt-in scoping" pattern used for Group Integrators.
model BusinessGoal {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())

  businessUnits BusinessGoalBusinessUnit[]
  rocks         Rock[]
}

// Join table: which Business Unit(s) a Business Goal has been assigned to.
model BusinessGoalBusinessUnit {
  businessGoalId String
  businessUnitId String

  businessGoal BusinessGoal @relation(fields: [businessGoalId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@id([businessGoalId, businessUnitId])
  @@index([businessUnitId])
}

// A "Rock" is an EOS-style 90-day priority owned by a Member Company for a
// given Year/Quarter. Added and kept up to date by BU Integrators (scoped to
// their assigned Business Unit(s)); Group Integrators/Superadmins can manage
// any Rock within their own scope, same as Quarter Actuals.
model Rock {
  id             String     @id @default(uuid())
  companyId      String
  yearId         String
  quarter        Int // 1-4
  businessGoalId String?
  title          String
  description    String     @default("")
  remarks        String     @default("")
  ownerName      String     @default("")
  status         RockStatus @default(PENDING)
  // Float (not Decimal) so Prisma Client returns a plain JS number here —
  // Decimal fields come back as Decimal.js objects, which would break the
  // plain arithmetic (+, -, Math.round, etc.) done on this value throughout
  // rocks.ts/scorecard.ts and the frontend. Callers are expected to round to
  // 2 decimal places themselves (see the zod transforms in routes/rocks.ts)
  // since Float can't enforce that at the column level the way
  // @db.Decimal(5, 2) would.
  progressPct    Float      @default(0)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year         Year          @relation(fields: [yearId], references: [id], onDelete: Cascade)
  businessGoal BusinessGoal? @relation(fields: [businessGoalId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("RockCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?         @relation("RockUpdatedBy", fields: [updatedById], references: [id])

  @@index([companyId])
  @@index([yearId, quarter])
  @@index([businessGoalId])
}
