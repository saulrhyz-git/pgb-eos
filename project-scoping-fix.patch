+// ─────────────────────────────────────────────────────────────────
+// Per-user project scoping for reads. Every non-superadmin account only
+// gets rows for the projects in session.user.project_ids (for
+// project_admin that's their own assignment; for role='user' it's their
+// assigned role's list — see auth.js resolveUserRole). Before this, GETs
+// returned every row to any logged-in user, so index.html/admin.html
+// showed all projects regardless of what was assigned.
+//
+// Deny by default: a non-superadmin with no assigned projects gets an
+// empty list, never "everything".
+// ─────────────────────────────────────────────────────────────────
+const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+function scopeClause(table, user, params) {
+  if (user?.role === 'superadmin') return null; // sees everything
+  const ids = (Array.isArray(user?.project_ids) ? user.project_ids : [])
+    .map(String).filter((id) => UUID_RE.test(id));
+  params.push(ids);
+  const p = `$${params.length}::uuid[]`;
+  switch (table) {
+    case 'psc_projects':    return `id = ANY(${p})`;
+    case 'psc_submissions': return `project_id = ANY(${p})`;
+    case 'psc_history':     return `project_id = ANY(${p})`;
+    // report meta is keyed by project code/name, not id
+    case 'psc_report_meta': return `project_code IN (SELECT code FROM psc_projects WHERE id = ANY(${p}))`;
+    default:                return 'false'; // unknown table: fail closed
+  }
+}
